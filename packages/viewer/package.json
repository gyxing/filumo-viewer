{
  "name": "@filumo/viewer",
  "version": "0.1.0",
  "description": "Standard lazy-loaded Filumo plugin preset for Office, PDF, images, text, Markdown, JSON, CSV, XML, source code and archive previews.",
  "keywords": [
    "filumo",
    "file-viewer",
    "file-preview",
    "document-viewer",
    "document-preview",
    "multi-format",
    "office-viewer",
    "pdf-viewer",
    "image-viewer",
    "text-viewer",
    "markdown-viewer",
    "json-viewer",
    "csv-viewer",
    "xml-viewer",
    "code-viewer",
    "archive-viewer",
    "zip",
    "docx",
    "xlsx",
    "pptx",
    "pdf",
    "jsonc",
    "jsonl",
    "ndjson",
    "csv",
    "tsv",
    "markdown",
    "typescript",
    "lazy-loading",
    "framework-agnostic",
    "readonly",
    "esm",
    "文件预览",
    "文档预览",
    "多格式预览"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/viewer#readme",
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/viewer"
  },
  "license": "MIT",
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "sideEffects": [
    "**/styles/**",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/archive": "workspace:^",
    "@filumo/code": "workspace:^",
    "@filumo/csv": "workspace:^",
    "@filumo/image": "workspace:^",
    "@filumo/json": "workspace:^",
    "@filumo/markdown": "workspace:^",
    "@filumo/office": "workspace:^",
    "@filumo/pdf": "workspace:^",
    "@filumo/text": "workspace:^",
    "@filumo/xml": "workspace:^"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
