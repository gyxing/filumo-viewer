{
  "name": "@fivo/dom",
  "version": "0.1.0-next.0",
  "description": "Fivo dom",
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js",
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fivo/core": "workspace:^"
  }
}
