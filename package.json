{
  "name": "filumo-workspace",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "description": "Filumo 跨框架文档预览工作区",
  "homepage": "https://gyxing.github.io/office-file-viewer/",
  "bugs": {
    "url": "https://github.com/gyxing/office-file-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/office-file-viewer.git"
  },
  "license": "MIT",
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "release:status": "node scripts/release/cli.mjs status",
    "release:version": "node scripts/release/cli.mjs version",
    "release:plan": "node scripts/release/cli.mjs plan",
    "release:publish": "node scripts/release/cli.mjs publish",
    "build": "node scripts/build/packages.mjs",
    "check": "pnpm run build && pnpm run check:types && pnpm run check:lint && pnpm run check:styles && pnpm --filter filumo-docs build",
    "check:lint": "eslint packages apps/docs/src --ext .ts,.tsx --ignore-pattern \"**/dist/**\"",
    "check:styles": "stylelint \"packages/*/src/**/*.less\" \"apps/docs/src/**/*.less\"",
    "check:types": "node scripts/checks/types.mjs",
    "demo": "node scripts/testing/serve-demo.mjs",
    "demo:js": "pnpm run demo --framework vanilla",
    "demo:react": "pnpm run demo --framework react",
    "demo:vue2": "pnpm run demo --framework vue2",
    "demo:vue3": "pnpm run demo --framework vue3",
    "docs:build": "node scripts/docs/run.mjs build",
    "docs:dev": "node scripts/docs/run.mjs dev",
    "smoke": "node scripts/docs/run.mjs smoke",
    "test": "node scripts/testing/run-unit.mjs",
    "test:acceptance": "node scripts/checks/acceptance.mjs",
    "test:browser": "node scripts/testing/run-browser.mjs",
    "test:browser:local": "node scripts/testing/run-browser.mjs --local",
    "test:consumers": "node scripts/testing/check-consumers.mjs",
    "test:consumers:hosts": "node scripts/testing/check-host-managers.mjs"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "lint-staged": {
    "*.{md,json}": ["prettier --write --no-error-on-unmatched-pattern"],
    "*.{css,less}": ["stylelint --fix", "prettier --write"],
    "*.{js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{ts,tsx}": ["eslint --fix", "prettier --parser=typescript --write"]
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.1.1",
    "@umijs/lint": "^4.0.0",
    "esbuild": "~0.18.20",
    "eslint": "^8.23.0",
    "husky": "^8.0.1",
    "less": "^4.1.3",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "semver": "7.8.5",
    "stylelint": "^14.9.1",
    "typescript": "5.4.2"
  }
}
