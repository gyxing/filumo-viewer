{
  "name": "@fivo/core",
  "version": "0.1.0-next.0",
  "description": "Fivo core",
  "license": "MIT",
  "sideEffects": [
    "**/styles/**",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "text": [
        "dist/text.d.ts"
      ]
    }
  }
}
