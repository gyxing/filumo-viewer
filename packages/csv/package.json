{
  "name": "@filumo/csv",
  "version": "0.1.0",
  "description": "Read-only CSV and TSV table viewer for Filumo, with delimiter detection, virtualized rows and columns, search and source view.",
  "keywords": [
    "filumo",
    "csv",
    "tsv",
    "csv-viewer",
    "tsv-viewer",
    "csv-preview",
    "table-viewer",
    "delimited-text",
    "delimiter-detection",
    "virtual-scroll",
    "row-virtualization",
    "column-virtualization",
    "column-resize",
    "cell-selection",
    "text-search",
    "source-view",
    "web-worker",
    "readonly",
    "typescript",
    "esm",
    "csv预览",
    "表格预览",
    "分隔符"
  ],
  "homepage": "https://github.com/gyxing/office-file-viewer/tree/master/packages/csv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/office-file-viewer.git",
    "directory": "packages/csv"
  },
  "bugs": {
    "url": "https://github.com/gyxing/office-file-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./worker.js": "./dist/worker.js"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  }
}
