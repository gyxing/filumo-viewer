{
  "name": "@filumo/image",
  "version": "0.1.0",
  "description": "Native browser image preview plugin and reusable image surfaces for Filumo, with zoom, rotation, panning and modal previews.",
  "keywords": [
    "filumo",
    "image",
    "image-viewer",
    "image-preview",
    "image-lightbox",
    "lightbox",
    "image-zoom",
    "image-rotation",
    "image-pan",
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp",
    "svg",
    "avif",
    "bmp",
    "browser",
    "readonly",
    "typescript",
    "esm",
    "图片预览",
    "图片查看器"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/image"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "view": ["dist/view/index.d.ts"]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  }
}
