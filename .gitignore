# 本机文件和运行记录不进入公开构建或提交
/tests/fixtures/local/
/tests/fixtures/public/generated/
/tmp/
/test-results/
/.codex-artifacts/
# 与本次清理无关的原用户材料保留忽略
/docs/files/

# 设计规格与实施计划仅保留本地，不纳入 Git 提交。
/docs/superpowers/specs/
/docs/superpowers/plans/

# 包版本常量在 build/check/test 前由本包 manifest 自动生成。
/packages/dom/src/generated/
/packages/office/src/generated/
/packages/text/src/generated/
/packages/json/src/generated/
