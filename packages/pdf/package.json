{
  "name": "@filumo/pdf",
  "version": "0.1.0",
  "description": "Continuous-scroll PDF viewer plugin for Filumo, with virtualized pages, outlines, thumbnails, text search and bounded canvas caches.",
  "keywords": [
    "filumo",
    "pdf",
    "pdf-viewer",
    "pdf-preview",
    "document-viewer",
    "file-preview",
    "pdfjs",
    "pdfjs-dist",
    "continuous-scroll",
    "virtual-scroll",
    "thumbnails",
    "outline",
    "text-search",
    "text-layer",
    "canvas",
    "web-worker",
    "lazy-loading",
    "readonly",
    "typescript",
    "esm",
    "pdf预览",
    "pdf阅读器",
    "文档预览"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/pdf#readme",
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/pdf"
  },
  "license": "MIT",
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/worker.js",
    "./dist/assets/pdfjs/legacy/build/pdf.worker.mjs",
    "./dist/chunks/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./worker.js": "./dist/worker.js",
    "./assets/*": "./dist/assets/*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "assets": [
        "dist/assets.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^",
    "pdfjs-dist": "6.4.299"
  },
  "publishConfig": {
    "access": "public"
  }
}
