{
  "name": "@filumo/xml",
  "version": "0.1.0",
  "description": "Read-only XML viewer for Filumo, with a resizable source/tree layout, namespace-aware colored labels and source-range navigation.",
  "keywords": [
    "filumo",
    "xml",
    "xml-viewer",
    "xml-preview",
    "xml-tree",
    "xml-source",
    "xml-namespaces",
    "cdata",
    "structured-data",
    "split-view",
    "syntax-highlighting",
    "source-navigation",
    "text-search",
    "line-numbers",
    "virtual-scroll",
    "web-worker",
    "readonly",
    "typescript",
    "esm",
    "xml预览",
    "xml查看器",
    "结构树"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/xml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/xml"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./worker.js": "./dist/worker.js"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^",
    "saxes": "6.0.0"
  }
}
