{
  "name": "@fivo/image",
  "version": "0.1.0-next.0",
  "description": "Fivo 图片预览与公共图片交互",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./dist/chunks/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fivo/core": "workspace:^",
    "@fivo/dom": "workspace:^"
  }
}
