{
  "name": "@filumo/dom",
  "version": "0.1.0",
  "description": "Framework-independent DOM file viewer shell for Filumo, with toolbars, shared text surfaces, outlines and style management.",
  "keywords": [
    "filumo",
    "document-viewer",
    "file-viewer",
    "file-preview",
    "document-preview",
    "dom",
    "vanilla-javascript",
    "framework-agnostic",
    "toolbar",
    "outline-tree",
    "text-viewer",
    "split-pane",
    "csp",
    "typescript",
    "esm",
    "文件预览",
    "文档预览"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/dom#readme",
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/dom"
  },
  "license": "MIT",
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "sideEffects": [
    "./src/outline.ts",
    "./src/outline/OutlineTree.ts",
    "./src/text.ts",
    "./src/text/mountTextSurface.ts",
    "./src/split.ts",
    "./src/split/SplitHandle.ts",
    "**/*.less",
    "./dist/index.js",
    "./dist/outline.js",
    "./dist/text.js",
    "./dist/split.js",
    "./src/grid.ts",
    "./dist/grid.js",
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./outline": {
      "types": "./dist/outline.d.ts",
      "import": "./dist/outline.js",
      "default": "./dist/outline.js"
    },
    "./styles.css": "./dist/styles.css",
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./text-messages": {
      "types": "./dist/text-messages.d.ts",
      "import": "./dist/text-messages.js",
      "default": "./dist/text-messages.js"
    },
    "./text-highlight": {
      "types": "./dist/text-highlight.d.ts",
      "import": "./dist/text-highlight.js",
      "default": "./dist/text-highlight.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js",
      "default": "./dist/grid.js"
    },
    "./split": {
      "types": "./dist/split.d.ts",
      "import": "./dist/split.js",
      "default": "./dist/split.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "outline": [
        "dist/outline.d.ts"
      ],
      "text": [
        "dist/text.d.ts"
      ],
      "text-messages": [
        "dist/text-messages.d.ts"
      ],
      "text-highlight": [
        "dist/text-highlight.d.ts"
      ],
      "grid": [
        "dist/grid.d.ts"
      ],
      "split": [
        "dist/split.d.ts"
      ],
      "html": [
        "dist/html.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
