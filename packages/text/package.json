{
  "name": "@filumo/text",
  "version": "0.1.0",
  "description": "Read-only plain text and log viewer for Filumo, with encoding detection, line numbers, search and readable-text fallback.",
  "keywords": [
    "filumo",
    "text",
    "text-viewer",
    "text-preview",
    "plain-text",
    "log-viewer",
    "txt",
    "log",
    "ini",
    "config-viewer",
    "encoding-detection",
    "utf-8",
    "utf-16",
    "gbk",
    "gb18030",
    "line-numbers",
    "word-wrap",
    "text-search",
    "virtual-scroll",
    "readonly",
    "typescript",
    "esm",
    "文本预览",
    "日志预览",
    "编码识别"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/text#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/text"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reader": {
      "types": "./dist/reader/index.d.ts",
      "import": "./dist/reader.js",
      "default": "./dist/reader.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    },
    "./styles.css": "./dist/styles.css",
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "reader": [
        "dist/reader/index.d.ts"
      ],
      "view": [
        "dist/view/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  }
}
