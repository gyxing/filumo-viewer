{
  "name": "@filumo/json",
  "version": "0.1.0",
  "description": "Read-only JSON, JSONC and JSON Lines viewer for Filumo, with split source/tree views, duplicate-key preservation and source navigation.",
  "keywords": [
    "filumo",
    "json",
    "json-viewer",
    "json-preview",
    "json-tree",
    "json-source",
    "jsonc",
    "jsonl",
    "ndjson",
    "json-lines",
    "structured-data",
    "duplicate-keys",
    "source-navigation",
    "split-view",
    "syntax-highlighting",
    "text-search",
    "line-numbers",
    "virtual-scroll",
    "web-worker",
    "readonly",
    "typescript",
    "esm",
    "json预览",
    "json查看器",
    "结构化数据"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/json#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/json"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  }
}
