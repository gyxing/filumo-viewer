{
  "name": "@filumo/markdown",
  "version": "0.1.1",
  "description": "Read-only Markdown viewer for Filumo, with heading outlines, GFM tables and task lists, controlled HTML rendering and lazy code highlighting.",
  "keywords": [
    "filumo",
    "markdown",
    "markdown-viewer",
    "markdown-preview",
    "md",
    "gfm",
    "readme-viewer",
    "heading-outline",
    "table-of-contents",
    "task-list",
    "markdown-table",
    "code-block",
    "syntax-highlighting",
    "html-rendering",
    "text-search",
    "lazy-loading",
    "readonly",
    "typescript",
    "esm",
    "markdown预览",
    "文档阅读",
    "目录导航"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/markdown#readme",
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/markdown"
  },
  "license": "MIT",
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "sideEffects": [
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^",
    "highlight.js": "11.12.0",
    "marked": "18.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
