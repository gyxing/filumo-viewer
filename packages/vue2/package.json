{
  "name": "@filumo/vue2",
  "version": "0.1.0",
  "description": "Vue 2 document viewer adapter for Filumo, with Options API integration, plugin-based formats and managed lifecycle cleanup.",
  "keywords": [
    "filumo",
    "vue",
    "vue2",
    "vue2-component",
    "vue-document-viewer",
    "vue-file-viewer",
    "vue-file-preview",
    "document-viewer",
    "file-preview",
    "options-api",
    "keep-alive",
    "typescript",
    "esm",
    "plugin-system",
    "lazy-loading",
    "readonly",
    "vue2文件预览",
    "vue2文档预览"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/vue2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/vue2"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/styles/**",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  },
  "devDependencies": {
    "vue": "2.7.16"
  },
  "peerDependencies": {
    "vue": "^2.6.14 || ^2.7.16"
  }
}
