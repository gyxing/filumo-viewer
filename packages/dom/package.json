{
  "name": "@fivo/dom",
  "version": "0.1.0-next.0",
  "description": "Fivo dom",
  "license": "MIT",
  "sideEffects": [
    "./src/outline.ts",
    "./src/outline/OutlineTree.ts",
    "**/*.less",
    "./dist/index.js",
    "./dist/outline.js",
    "./dist/chunks/*.js",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./outline": {
      "types": "./dist/outline.d.ts",
      "import": "./dist/outline.js",
      "default": "./dist/outline.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "outline": [
        "dist/outline.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fivo/core": "workspace:^"
  }
}
