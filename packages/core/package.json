{
  "name": "@filumo/core",
  "version": "0.1.0",
  "description": "Headless document sessions, file sources and plugin protocols for Filumo, with DOM-free text utilities.",
  "keywords": [
    "filumo",
    "document-core",
    "document-session",
    "document-source",
    "file-source",
    "headless",
    "plugin-system",
    "resource-policy",
    "range-request",
    "abort-signal",
    "text-decoding",
    "typescript",
    "esm",
    "文档会话",
    "文件读取"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/styles/**",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "typesVersions": {
    "*": {
      "text": [
        "dist/text.d.ts"
      ]
    }
  }
}
