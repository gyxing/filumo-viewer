{
  "name": "@filumo/react",
  "version": "0.1.0",
  "description": "React 18 and 19 document viewer adapter for Filumo, with typed refs, plugin-based formats and managed viewer cleanup.",
  "keywords": [
    "filumo",
    "react",
    "react18",
    "react19",
    "react-component",
    "react-document-viewer",
    "react-file-viewer",
    "react-file-preview",
    "document-viewer",
    "file-preview",
    "typed-ref",
    "typescript",
    "esm",
    "plugin-system",
    "lazy-loading",
    "readonly",
    "react文件预览",
    "react文档预览"
  ],
  "homepage": "https://github.com/gyxing/filumo-viewer/tree/master/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyxing/filumo-viewer.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gyxing/filumo-viewer/issues"
  },
  "author": {
    "name": "gyxing",
    "url": "https://github.com/gyxing"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/styles/**",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@filumo/core": "workspace:^",
    "@filumo/dom": "workspace:^"
  },
  "devDependencies": {
    "react": "^18.0.0",
    "@types/react": "^18.0.0"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  }
}
